@model SiteContent
@{
	ViewData["Title"] = "Главная";

	// Events and news are edited in the admin panel (AdminController); the first event keeps
	// its old modal id so existing links like /#first_event still open it.
	var events = Model.Events.Where(e => e.IsVisible).ToList();
	var news = Model.News.Where(n => n.IsVisible).ToList();
	string ModalId(int index, SiteEvent e) => index == 0 ? "first_event" : $"event_{e.Id:N}";
}

<div class="main-columns container">
	<div class="column column--news">
		<h2 class="section__title">Новости</h2>
		@foreach (var item in news)
		{
			<div class="card news__card">
				<h3>@item.Title</h3>
				<p>@RuDate.Short(item.Date)</p>
				<a href="@item.Url" target="_blank" rel="noopener" class="btn">Читать</a>
			</div>
		}
	</div>

	<div class="column column--event">
		<h2 class="section__title">Мероприятия</h2>
		@for (var i = 0; i < events.Count; i++)
		{
			var item = events[i];
			<div class="card event__card">
				<img src="@(item.ImageUrl ?? "/images/event-placeholder.jpg")" alt="Мероприятие" class="event__image" />
				<div class="event__desc_off">
					<p>@item.Location</p>
					<button type="button" class="btn js-open-modal" data-modal-target="@ModalId(i, item)">Подробнее</button>
				</div>
			</div>
		}
		@if (events.Count == 0)
		{
			<div class="card event__card">
				<p>Скоро здесь появятся новые мероприятия.</p>
			</div>
		}
	</div>

	@for (var i = 0; i < events.Count; i++)
	{
		var item = events[i];
		@await Component.InvokeAsync("EventModal", new EventModalViewModel
		{
			Id = ModalId(i, item),
			Title = "Информация о мероприятии",
			Date = RuDate.Long(item.Date),
			Location = item.Location,
			FilePath = item.PdfUrl
		})
	}
</div>
